<% if (page.total > 1) { %>
  <div class="pagination">
    <%
      var currentUrl = page.path || '';
      var base = '';
      
      if (currentUrl.indexOf('categories/') !== -1) {
        base = currentUrl.replace(/page\/\d+\//, '').replace(/index\.html$/, '').replace(/\/$/, '');
      } else if (currentUrl.indexOf('tags/') !== -1) {
        base = currentUrl.replace(/page\/\d+\//, '').replace(/index\.html$/, '').replace(/\/$/, '');
      } else if (currentUrl.indexOf('archives') !== -1) {
        base = 'archives';
      } else {
        base = '';
      }
      
      // 生成单个页码链接
      function pageLink(i) {
        if (i === 1) {
          return base ? '/' + base + '/' : '/';
        } else {
          return base ? '/' + base + '/page/' + i + '/' : '/page/' + i + '/';
        }
      }
      
      var total = page.total;
      var current = page.current;
      var maxVisible = 5; // 最多显示5个页码
      var pages = [];
      
      if (total <= maxVisible + 2) {
        // 总页数少，全部显示
        for (var i = 1; i <= total; i++) {
          pages.push(i);
        }
      } else {
        // 始终显示第一页
        pages.push(1);
        
        var start = Math.max(2, current - 1);
        var end = Math.min(total - 1, current + 1);
        
        // 调整范围确保显示足够的页码
        if (current <= 3) {
          end = Math.min(maxVisible, total - 1);
        } else if (current >= total - 2) {
          start = Math.max(2, total - maxVisible + 1);
        }
        
        if (start > 2) {
          pages.push('...');
        }
        
        for (var i = start; i <= end; i++) {
          pages.push(i);
        }
        
        if (end < total - 1) {
          pages.push('...');
        }
        
        // 始终显示最后一页
        pages.push(total);
      }
    %>

    <% if (page.prev) { %>
      <a href="<%= url_for(page.prev_link).replace(/index\.html$/, '') %>" class="page-prev">← 前页</a>
    <% } else { %>
      <span class="page-prev disabled">← 前页</span>
    <% } %>

    <span class="page-numbers">
      <% pages.forEach(function(p) { %>
        <% if (p === '...') { %>
          <span class="page-ellipsis">…</span>
        <% } else if (p === page.current) { %>
          <span class="page-current"><%= p %></span>
        <% } else { %>
          <a href="<%= url_for(pageLink(p)).replace(/index\.html$/, '') %>"><%= p %></a>
        <% } %>
      <% }); %>
    </span>

    <% if (page.next) { %>
      <a href="<%= url_for(page.next_link).replace(/index\.html$/, '') %>" class="page-next">后页 →</a>
    <% } else { %>
      <span class="page-next disabled">后页 →</span>
    <% } %>
  </div>
<% } %>