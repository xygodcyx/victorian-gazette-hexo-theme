<!-- 报头 -->
<header class="masthead">
  <h1 class="newspaper-title">
    <a href="<%= url_for('/') %>" style="color: inherit; text-decoration: none;">
      <%= theme.title || config.title %>
    </a>
  </h1>
  <div class="date-line">
    ◆ 中国 · <%= date(Date.now(), config.date_format || 'YYYY年M月D日') %> ◆ 每日号外
  </div>
</header>

<!-- 导航 -->
<nav class="nav-section">
  <ul class="nav-list">
    <%
      // 获取当前页面路径
      var currentPath = page.path || '';
      // 首页路径特殊处理
      var isHome = is_home();
    %>
    
    <% for (var link in theme.menu) { %>
      <%
        var menuUrl = url_for(theme.menu[link]);
        var isActive = false;
        
        // 首页匹配
        if (theme.menu[link] === '/' && isHome) {
          isActive = true;
        }
        // 其他页面：当前路径以菜单路径开头
        else if (theme.menu[link] !== '/' && currentPath.indexOf(theme.menu[link].replace('/', '')) === 0) {
          isActive = true;
        }
      %>
      <li>
        <a class="<%= isActive ? 'current' : '' %>" href="<%= menuUrl %>"><%= link %></a>
      </li>
    <% } %>
    
    <li>
      <a class="<%= currentPath.indexOf('archives') === 0 ? 'current' : '' %>" href="<%= url_for('/archives') %>">档案室</a>
    </li>

    <button class="open-search" title="搜索 (Ctrl+K)">
      搜索 (Ctrl+K)
    </button>
  </ul>
</nav>