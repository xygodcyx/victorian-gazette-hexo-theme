<article class="story-card" id="post-<%= post.title %>">
    <h2 class="story-card-title">
        <a href="<%= url_for(post.path) %>"><%= post.title %></a>
    </h2>
    <div class="story-card-meta">
        <%= date(post.date, 'YYYY年M月D日') %>
        <!-- 如果文章修改过，显示编辑标记 -->
        <% if (post.updated && post.updated !== post.date) { %>
        · 修订于 <%= date(post.updated, 'YYYY年M月D日') %>
        <% } %>

        <% if (post.categories && post.categories.length) { %>
        · <% post.categories.each(function(cat) { %>
            <a href="/<%= cat.path %>"><%= cat.name %></a>
        <% }); %>
        <% } %>

        <% if (post.tags && post.tags.length) { %>
        · <% post.tags.each(function(tag) { %>
            <a href="/<%= tag.path %>"><%= tag.name %></a>
        <% }); %>
        <% } %>
        <% if (post.comments !== undefined && typeof post.comments === 'number' && post.comments > 0) { %>
        · <%= post.comments %>封来信
        <% } else if((theme.comment.enable)) { %>
        · 暂无来信
        <% } else { %>

        <% } %>
             
        
    </div>
    <p class="story-card-excerpt">
        <%- post.excerpt || safe_truncate(post.content , { length:100 }) %>
    </p>
    <a href="<%= url_for(post.path) %>" class="card-read-more">继续阅读 →</a>
</article>