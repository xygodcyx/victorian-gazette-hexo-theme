<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <link rel="shortcut icon" href="<%= config.icon || theme.icon %>" type="image/x-icon">
  <title>
    <% if (is_home()) { %> <%= theme.title || config.title %><%=
   "'" + config.subtitle %> <% } else if (is_post()) { %> <%=
    page.title %> · <%= theme.title || config.title %> <% } else if
    (is_archive()) { %> 归档 · <%= theme.title || config.title %> <% } else
    { %> <%= page.title %> · <%= theme.title || config.title %> <% } %>
  </title>
  <link
    rel="stylesheet"
    href="<%- url_for('/css/style.css') %>"
  />
  <link
    rel="stylesheet"
    href="<%- url_for('/css/post.css') %>"
  />
  <link
    rel="stylesheet"
    href="<%- url_for('/css/paranote.css') %>"
  />
  <link
    rel="stylesheet"
    href="<%- url_for('/css/marginalia.css') %>"
  />
  <link
    rel="stylesheet"
    href="<%- url_for('/css/highlight.css') %>"
  />
  <link
    rel="stylesheet"
    href="<%- url_for('/css/search.css') %>"
  />
  <link
    rel="stylesheet"
    href="<%- url_for('/css/print.css') %>"
  />

  <% if (theme.math && theme.math.enable) { %>
    <link rel="stylesheet" href="<%= url_for('/css/math.css') %>" />
  <% } %>

</head>
