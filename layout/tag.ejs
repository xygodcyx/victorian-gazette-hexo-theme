<div class="article-main" style="margin: 0;">
  <header class="article-header">
    <p class="article-chapter">标签索引</p>
    <h1 class="article-title"># <%= page.tag %></h1>
    <p class="article-subtitle">
      <% if (typeof page.posts !== "undefined") { %>
       —— 本标签下共有 <%= page.posts.length %> 篇文章
      <% } %>
    </p>
  </header>

  <% if (typeof page.posts !== "undefined" && page.posts.length > 0) { %>
    <div class="story-list">
      <% page.posts.each(function(post) { %>
        <%- partial('_partial/story-card', { post }) %>
      <% }); %>
    </div>

    <%- partial('_partial/pagination') %>

  <% } else { %>
    <div style="text-align: center; padding: 3rem 1rem;">
      <p style="font-family: var(--font-decorative); font-size: 1.2rem; color: var(--text-secondary);">
        此标签下暂无文章
      </p>
    </div>
  <% } %>
</div>

<!-- 标签云导航 -->
<div class="widget" style="margin-top: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
  <h3 class="widget-title">所有标签</h3>
  <div class="tag-cloud">
    <% site.tags.sort('name').each(function(tag) { %>
      <a href="<%= url_for(tag.path) %>" class="tag <%= page.tag === tag.name ? 'current' : '' %>">
        <%= tag.name %> (<%= tag.posts.length %>)
      </a>
    <% }); %>
  </div>
</div>

<style>
  .tag.current {
    background: var(--accent-darkred);
    color: #fff;
    border-color: var(--accent-darkred);
    box-shadow: 0 0 8px rgba(74, 26, 26, 0.3);
  }
</style>